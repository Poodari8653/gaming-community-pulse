{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "dashboard": {
      "root": "./",
      "framework": "express",
      "entrypoint": "server/server.js",
      "installCommand": "npm install"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "dashboard" } }
  ]
}
