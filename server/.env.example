# ---------------------------------------------------------------------------
# Gaming Community Pulse — environment configuration
#
# Copy this file to `server/.env` and fill in the values you have:
#     cp server/.env.example server/.env
#
# NOTHING HERE IS MANDATORY. The dashboard boots with no credentials at all —
# every unconfigured source is labelled "not configured" on screen rather than
# failing. Add credentials to switch each source from sample data to live.
# ---------------------------------------------------------------------------


# --- Semantic analysis + AI daily briefing ---------------------------------
# Powers the two headline features: sentiment that reads meaning rather than
# keywords (sarcasm, negation, gaming slang), and the AI-written daily brief.
# Without it, sentiment falls back to a gaming-tuned lexicon and the brief is
# composed from the computed figures instead. Get a key at
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5. Set a cheaper tier here if you want to
# trade some accuracy for cost on high-volume scoring.
# ANTHROPIC_MODEL=claude-opus-5


# --- YouTube (Data API v3) --------------------------------------------------
# Google Cloud Console → enable "YouTube Data API v3" → create an API key.
# Free quota is 10,000 units/day; a full refresh of all five channels costs
# roughly 95 units, so the quota is not a practical constraint.
YOUTUBE_API_KEY=


# --- Reddit (OAuth API) -----------------------------------------------------
# https://www.reddit.com/prefs/apps → "create another app" → type "script".
# The client ID is the string under the app name; the secret is labelled.
# Application-only auth is used by default, which is read-only access to
# public subreddits — no user account acts on anyone's behalf.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Optional. Only needed if you want the script-app password grant instead of
# application-only auth. Leave blank for normal use.
# REDDIT_USERNAME=
# REDDIT_PASSWORD=

# Optional. Reddit requires a descriptive User-Agent and treats generic ones as
# abuse. The default identifies this app; override to add your own contact.
# REDDIT_USER_AGENT=nodejs:gaming-community-pulse:v2.0 (contact: you@example.com)


# --- Discord (Bot REST API) -------------------------------------------------
# https://discord.com/developers/applications → your app → Bot → Reset Token.
# The bot must be INVITED to each server you want to read, with "View Channels"
# and "Read Message History", and "Message Content Intent" enabled — without
# that intent, message text comes back empty even though the call succeeds.
DISCORD_BOT_TOKEN=


# --- Twitch (Helix API) -----------------------------------------------------
# https://dev.twitch.tv/console → Register Your Application → copy the Client
# ID and generate a Client Secret. Uses the client-credentials flow, so no
# per-user Twitch login is involved.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=


# --- Access control ----------------------------------------------------------
# This is an internal tool and must not be left reachable by anyone who finds
# the URL. Set a comma-separated list of username:password pairs to require
# login (HTTP Basic Auth) on every route, static dashboard included:
#     AUTH_USERS=alice:correct-horse-battery,bob:another-passphrase
# If this is left unset, the app still boots (matching every other optional
# integration here) but is WIDE OPEN — a loud warning prints at startup when
# that's the case. Only leave it unset for local testing on your own machine.
AUTH_USERS=


# --- Behaviour --------------------------------------------------------------
# Set to false to exclude the illustrative sample data entirely and run on
# collected data only. Default is true, and every sample row is tagged in the
# UI and counted in the provenance banner.
# DEMO_DATA=true

# Where daily snapshots are written, which is what makes day-over-day deltas
# possible. Defaults to <repo>/data/snapshots; point this at a mounted volume
# in production so history survives restarts and redeploys.
# SNAPSHOT_DIR=/var/lib/gaming-community-pulse/snapshots

# Port. Render, Vercel and most PaaS providers inject this automatically —
# leave it unset there.
# PORT=3000
